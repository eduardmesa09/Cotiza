# Opcional. Copie este archivo como .env para cambiar los valores por defecto de Docker Compose.

# Puertos publicados en su equipo (cámbielos si alguno está ocupado).
WEB_PORT=8080
API_PORT=8000
ERP_PORT=8001
DB_PORT=5433

# Clave con la que se firman las sesiones. La de por defecto solo sirve para la demo.
JWT_SECRET=solo-para-demo-cambiar-en-produccion
